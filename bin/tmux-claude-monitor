#!/bin/bash
# tmux-claude-monitor - Main monitoring daemon for Claude Code sessions
# Created: 2025-08-07

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${SCRIPT_DIR}/../lib"
readonly CONF_DIR="${SCRIPT_DIR}/../conf"
[[ -z "${STATE_DIR:-}" ]] && readonly STATE_DIR="/tmp/tmux-claude"
[[ -z "${PID_FILE:-}" ]] && readonly PID_FILE="${STATE_DIR}/monitor.pid"
[[ -z "${LOG_FILE:-}" ]] && readonly LOG_FILE="${STATE_DIR}/monitor.log"

source "${LIB_DIR}/state_manager.sh"
source "${LIB_DIR}/claude_patterns.sh"

readonly DEFAULT_TIMEOUT=300
readonly MONITOR_INTERVAL=2
[[ -z "${DEBUG:-}" ]] && readonly DEBUG="false"

log() {
    local level="$1"
    shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*" >> "$LOG_FILE"
    if [[ "$DEBUG" == "true" ]] || [[ "$level" == "ERROR" ]]; then
        echo "[$level] $*" >&2
    fi
}

is_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

start_daemon() {
    if is_running; then
        log "INFO" "Monitor already running (PID: $(cat "$PID_FILE"))"
        exit 0
    fi
    
    init_state_dir
    
    (
        trap cleanup EXIT INT TERM
        echo $$ > "$PID_FILE"
        log "INFO" "Starting tmux-claude-monitor (PID: $$)"
        
        monitor_loop
    ) &
    
    echo "tmux-claude-monitor started (PID: $!)"
}

stop_daemon() {
    if [[ -f "$PID_FILE" ]]; then
        local pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            log "INFO" "Stopping monitor (PID: $pid)"
            kill "$pid"
            rm -f "$PID_FILE"
            echo "tmux-claude-monitor stopped"
        else
            rm -f "$PID_FILE"
            echo "Monitor not running (stale PID file removed)"
        fi
    else
        echo "Monitor not running"
    fi
}

cleanup() {
    log "INFO" "Cleaning up monitor"
    
    for pane in $(list_monitored_panes); do
        stop_monitoring_pane "$pane"
    done
    
    rm -f "$PID_FILE"
}

detect_claude_panes() {
    # Detect panes running Claude-related commands:
    # - claude, claude-code, claude_code: Direct Claude executables
    # - npx: Often used to run Claude via npx (e.g., npx claude)
    tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index} #{pane_current_command}" 2>/dev/null | \
    while read -r pane_id command; do
        if [[ "$command" =~ claude|claude-code|claude_code|npx ]]; then
            echo "$pane_id"
        fi
    done
}

start_monitoring_pane() {
    local pane_id="$1"
    local clean_id=$(get_pane_id "$pane_id")
    
    if is_pane_monitored "$pane_id"; then
        log "DEBUG" "Pane $pane_id already monitored"
        return
    fi
    
    log "INFO" "Starting monitoring for pane $pane_id"
    
    local log_file="${STATE_DIR}/${clean_id}.log"
    touch "$log_file"
    
    tmux pipe-pane -t "$pane_id" "cat >> '$log_file'" 2>/dev/null || {
        log "ERROR" "Failed to set up pipe-pane for $pane_id"
        return 1
    }
    
    set_pane_monitored "$pane_id" true
    update_last_activity "$pane_id"
}

stop_monitoring_pane() {
    local pane_id="$1"
    local clean_id=$(get_pane_id "$pane_id")
    
    log "INFO" "Stopping monitoring for pane $pane_id"
    
    tmux pipe-pane -t "$pane_id" 2>/dev/null || true
    
    set_pane_monitored "$pane_id" false
    clear_pane_status "$pane_id"
    
    rm -f "${STATE_DIR}/${clean_id}.log"
}

check_pane() {
    local pane_id="$1"
    local clean_id=$(get_pane_id "$pane_id")
    local log_file="${STATE_DIR}/${clean_id}.log"
    local timeout="${CLAUDE_TIMEOUT:-$DEFAULT_TIMEOUT}"
    
    if ! tmux has-session -t "${pane_id%%:*}" 2>/dev/null; then
        log "DEBUG" "Session for $pane_id no longer exists"
        stop_monitoring_pane "$pane_id"
        return
    fi
    
    local current_status=$(get_pane_status "$pane_id")
    local new_status=""
    
    if check_inactivity "$clean_id" "$timeout"; then
        new_status="⏱"
        log "DEBUG" "Pane $pane_id is inactive (timeout)"
    else
        local state=$(analyze_pane_content "$log_file")
        new_status=$(get_status_symbol "$state")
        
        if [[ -n "$new_status" ]]; then
            log "DEBUG" "Pane $pane_id state: $state (symbol: $new_status)"
        fi
    fi
    
    if [[ "$new_status" != "$current_status" ]] && [[ -n "$new_status" ]]; then
        set_pane_status "$pane_id" "$new_status"
        
        if [[ "$new_status" == "❓" ]] || [[ "$new_status" == "⏱" ]]; then
            notify_user "$pane_id" "$new_status"
        fi
    elif [[ -z "$new_status" ]] && [[ "$current_status" != "none" ]]; then
        clear_pane_status "$pane_id"
    fi
    
    if [[ "$new_status" != "⏱" ]]; then
        update_last_activity "$pane_id"
    fi
}

notify_user() {
    local pane_id="$1"
    local status="$2"
    local notify_method="${CLAUDE_NOTIFY:-bell}"
    
    log "INFO" "Notifying user about $pane_id (status: $status)"
    
    case "$notify_method" in
        bell)
            tmux send-keys -t "$pane_id" C-g 2>/dev/null || true
            ;;
        flash)
            tmux select-pane -t "$pane_id" -P 'bg=red' 2>/dev/null || true
            sleep 0.1
            tmux select-pane -t "$pane_id" -P 'default' 2>/dev/null || true
            ;;
        system)
            if command -v notify-send &>/dev/null; then
                local message="Pane $pane_id needs attention"
                if [[ "$status" == "❓" ]]; then
                    message="Claude needs input in $pane_id"
                elif [[ "$status" == "⏱" ]]; then
                    message="Claude session stalled in $pane_id"
                fi
                notify-send "tmux-claude" "$message" 2>/dev/null || true
            fi
            ;;
        none)
            ;;
    esac
}

monitor_loop() {
    log "INFO" "Monitor loop started"
    
    while true; do
        cleanup_stale_state
        
        for pane in $(detect_claude_panes); do
            if ! is_pane_monitored "$pane"; then
                start_monitoring_pane "$pane"
            fi
        done
        
        for pane in $(list_monitored_panes); do
            check_pane "$pane"
        done
        
        sleep "$MONITOR_INTERVAL"
    done
}

status() {
    if is_running; then
        echo "Monitor: Running (PID: $(cat "$PID_FILE"))"
    else
        echo "Monitor: Stopped"
    fi
    
    echo
    echo "Monitored Panes:"
    get_all_statuses
}

main() {
    case "${1:-}" in
        start)
            start_daemon
            ;;
        stop)
            stop_daemon
            ;;
        restart)
            stop_daemon
            sleep 1
            start_daemon
            ;;
        status)
            status
            ;;
        debug)
            export DEBUG=true
            init_state_dir
            trap cleanup EXIT INT TERM
            echo $$ > "$PID_FILE"
            monitor_loop
            ;;
        *)
            echo "Usage: $0 {start|stop|restart|status|debug}"
            echo
            echo "  start   - Start the monitoring daemon"
            echo "  stop    - Stop the monitoring daemon"
            echo "  restart - Restart the monitoring daemon"
            echo "  status  - Show current status and monitored panes"
            echo "  debug   - Run in foreground with debug output"
            exit 1
            ;;
    esac
}

main "$@"