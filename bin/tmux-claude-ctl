#!/bin/bash
# tmux-claude-ctl - Control utility for tmux-claude-ext
# Created: 2025-08-07

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${SCRIPT_DIR}/../lib"
[[ -z "${STATE_DIR:-}" ]] && readonly STATE_DIR="/tmp/tmux-claude"

source "${LIB_DIR}/state_manager.sh"
source "${LIB_DIR}/claude_patterns.sh"

readonly MONITOR_CMD="${SCRIPT_DIR}/tmux-claude-monitor"

show_status() {
    echo "=== tmux-claude Status ==="
    echo
    
    if [[ -f "${STATE_DIR}/monitor.pid" ]]; then
        local pid=$(cat "${STATE_DIR}/monitor.pid")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Monitor: Running (PID: $pid)"
        else
            echo "Monitor: Stopped (stale PID file)"
        fi
    else
        echo "Monitor: Not running"
    fi
    
    echo
    
    local monitoring_enabled=$(tmux show-option -gqv @claude-monitor 2>/dev/null || echo "on")
    echo "Monitoring: $monitoring_enabled"
    
    local timeout=$(tmux show-option -gqv @claude-timeout 2>/dev/null || echo "300")
    echo "Timeout: ${timeout}s"
    
    local notify=$(tmux show-option -gqv @claude-notify 2>/dev/null || echo "bell")
    echo "Notifications: $notify"
    
    echo
    echo "=== Monitored Panes ==="
    echo
    
    get_all_statuses
    
    local alerts=0
    for pane in $(list_monitored_panes); do
        local status=$(get_pane_status "$pane")
        if [[ "$status" == "❓" ]] || [[ "$status" == "⏱" ]]; then
            ((alerts++))
        fi
    done
    
    if [[ $alerts -gt 0 ]]; then
        echo
        echo "⚠️  $alerts pane(s) need attention"
    fi
}

clear_current() {
    local current_pane=$(tmux display -p '#{session_name}:#{window_index}.#{pane_index}')
    
    if is_pane_monitored "$current_pane"; then
        clear_pane_status "$current_pane"
        echo "Cleared status for $current_pane"
    else
        echo "Current pane is not being monitored"
    fi
}

clear_all() {
    local count=0
    for pane in $(list_monitored_panes); do
        clear_pane_status "$pane"
        ((count++))
    done
    echo "Cleared status for $count pane(s)"
}

goto_next_alert() {
    local alerts=()
    
    for pane in $(list_monitored_panes); do
        local status=$(get_pane_status "$pane")
        if [[ "$status" == "❓" ]] || [[ "$status" == "⏱" ]] || [[ "$status" == "❌" ]]; then
            alerts+=("$pane")
        fi
    done
    
    if [[ ${#alerts[@]} -eq 0 ]]; then
        echo "No panes need attention"
        return 1
    fi
    
    local current_pane=$(tmux display -p '#{session_name}:#{window_index}.#{pane_index}')
    local next_pane="${alerts[0]}"
    
    for i in "${!alerts[@]}"; do
        if [[ "${alerts[$i]}" == "$current_pane" ]] && [[ $((i + 1)) -lt ${#alerts[@]} ]]; then
            next_pane="${alerts[$((i + 1))]}"
            break
        fi
    done
    
    echo "Switching to $next_pane"
    tmux select-window -t "${next_pane%.*}"
    tmux select-pane -t "$next_pane"
}

mute_monitoring() {
    tmux set-option -g @claude-monitor off
    echo "Monitoring disabled"
}

unmute_monitoring() {
    tmux set-option -g @claude-monitor on
    echo "Monitoring enabled"
    
    if ! pgrep -f "tmux-claude-monitor" &>/dev/null; then
        "$MONITOR_CMD" start
    fi
}

show_config() {
    echo "=== Configuration ==="
    echo
    echo "Monitor enabled:  $(tmux show-option -gqv @claude-monitor || echo 'on')"
    echo "Timeout:         $(tmux show-option -gqv @claude-timeout || echo '300')s"
    echo "Bell:            $(tmux show-option -gqv @claude-bell || echo 'on')"
    echo "Style:           $(tmux show-option -gqv @claude-style || echo 'symbols')"
    echo "Notifications:   $(tmux show-option -gqv @claude-notify || echo 'bell')"
    echo
    echo "Custom symbols:"
    echo "  Choice:   $(tmux show-option -gqv @claude-symbol-choice || echo '❓')"
    echo "  Timeout:  $(tmux show-option -gqv @claude-symbol-timeout || echo '⏱')"
    echo "  Error:    $(tmux show-option -gqv @claude-symbol-error || echo '❌')"
    echo "  Complete: $(tmux show-option -gqv @claude-symbol-complete || echo '✅')"
    echo "  Thinking: $(tmux show-option -gqv @claude-symbol-thinking || echo '🤔')"
    echo "  Active:   $(tmux show-option -gqv @claude-symbol-active || echo '🔄')"
}

set_config() {
    local key="$1"
    local value="$2"
    
    case "$key" in
        timeout)
            tmux set-option -g @claude-timeout "$value"
            echo "Timeout set to ${value}s"
            ;;
        notify)
            if [[ "$value" =~ ^(bell|flash|system|none)$ ]]; then
                tmux set-option -g @claude-notify "$value"
                echo "Notification method set to $value"
            else
                echo "Invalid notification method. Use: bell, flash, system, or none"
                return 1
            fi
            ;;
        style)
            if [[ "$value" =~ ^(symbols|colors|both)$ ]]; then
                tmux set-option -g @claude-style "$value"
                echo "Style set to $value"
            else
                echo "Invalid style. Use: symbols, colors, or both"
                return 1
            fi
            ;;
        *)
            echo "Unknown configuration key: $key"
            echo "Available keys: timeout, notify, style"
            return 1
            ;;
    esac
}

show_log() {
    local pane="${1:-}"
    local lines="${2:-50}"
    
    if [[ -z "$pane" ]]; then
        pane=$(tmux display -p '#{session_name}:#{window_index}.#{pane_index}')
    fi
    
    local clean_id=$(get_pane_id "$pane")
    local log_file="${STATE_DIR}/${clean_id}.log"
    
    if [[ -f "$log_file" ]]; then
        echo "=== Last $lines lines from $pane ==="
        tail -n "$lines" "$log_file"
    else
        echo "No log file found for $pane"
        return 1
    fi
}

analyze_pane() {
    local pane="${1:-}"
    
    if [[ -z "$pane" ]]; then
        pane=$(tmux display -p '#{session_name}:#{window_index}.#{pane_index}')
    fi
    
    local clean_id=$(get_pane_id "$pane")
    local log_file="${STATE_DIR}/${clean_id}.log"
    
    echo "=== Analysis for $pane ==="
    echo
    
    if [[ ! -f "$log_file" ]]; then
        echo "No log file found"
        return 1
    fi
    
    local state=$(analyze_pane_content "$log_file")
    local symbol=$(get_status_symbol "$state")
    
    echo "Current state: $state $symbol"
    echo
    
    if [[ "$state" == "prompt" ]]; then
        echo "Last prompt detected:"
        extract_last_prompt "$log_file"
    fi
    
    echo
    echo "Log file: $log_file"
    echo "Size: $(wc -c < "$log_file" | xargs) bytes"
    echo "Lines: $(wc -l < "$log_file" | xargs)"
    
    local last_modified=$(stat -f %m "$log_file" 2>/dev/null || stat -c %Y "$log_file" 2>/dev/null)
    local current_time=$(date +%s)
    local inactive_time=$((current_time - last_modified))
    
    echo "Last activity: ${inactive_time}s ago"
}

add_current_pane() {
    local pane=$(tmux display -p '#{session_name}:#{window_index}.#{pane_index}')
    
    # Start monitoring this pane
    set_pane_monitored "$pane" true
    
    # Start pipe-pane to capture output
    local clean_id=$(get_pane_id "$pane")
    tmux pipe-pane -t "$pane" "cat >> ${STATE_DIR}/${clean_id}.log"
    
    echo "✅ Added pane $pane to monitoring"
    echo "   This pane will now be monitored for Claude activity"
    
    # Set initial status
    set_pane_status "$pane" "🔄"
}

add_find_all_panes() {
    echo "🔍 Searching for Claude-like processes..."
    local count=0
    local skipped=0
    
    # Find all panes with potential Claude processes
    while IFS=$'\t' read -r pane_id command; do
        # Check for Claude-related commands
        if [[ "$command" =~ claude|claude-code|claude_code|npx|node|python ]]; then
            if ! is_pane_monitored "$pane_id"; then
                # Verify it looks like Claude by checking pane content
                local test_content=$(tmux capture-pane -t "$pane_id" -p 2>/dev/null | tail -20)
                
                # Look for Claude-specific patterns
                if echo "$test_content" | grep -qiE "(claude|assistant|thinking|analyzing|choose one|enter.*choice|\[Y/n\]|Would you like)"; then
                    echo "  ✅ Adding $pane_id ($command)"
                    
                    # Add to monitoring
                    set_pane_monitored "$pane_id" true
                    
                    # Start pipe-pane
                    local clean_id=$(get_pane_id "$pane_id")
                    local log_file="${STATE_DIR}/${clean_id}.log"
                    tmux pipe-pane -t "$pane_id" "cat >> '$log_file'" 2>/dev/null
                    
                    # Capture initial content and analyze
                    tmux capture-pane -t "$pane_id" -p | tail -100 > "$log_file"
                    local state=$(analyze_pane_content "$log_file")
                    local symbol=$(get_status_symbol "$state")
                    
                    if [[ -n "$symbol" ]]; then
                        set_pane_status "$pane_id" "$symbol"
                    else
                        set_pane_status "$pane_id" "🔄"
                    fi
                    
                    ((count++))
                else
                    echo "  ⏭️  Skipping $pane_id ($command) - no Claude patterns found"
                fi
            else
                echo "  ✓ Already monitoring $pane_id"
                ((skipped++))
            fi
        fi
    done < <(tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}	#{pane_current_command}")
    
    echo
    echo "📊 Summary:"
    echo "  - Added: $count pane(s)"
    echo "  - Already monitored: $skipped pane(s)"
    
    if [[ $count -gt 0 ]]; then
        echo
        echo "Use 'claude-ctl status' to see all monitored panes"
    fi
}

main() {
    case "${1:-status}" in
        status)
            show_status
            ;;
        add|add-pane)
            add_current_pane
            ;;
        add-find-all|find-all|add-all)
            add_find_all_panes
            ;;
        clear)
            if [[ "${2:-}" == "all" ]]; then
                clear_all
            else
                clear_current
            fi
            ;;
        goto|next)
            goto_next_alert
            ;;
        mute|disable)
            mute_monitoring
            ;;
        unmute|enable)
            unmute_monitoring
            ;;
        config)
            if [[ $# -eq 1 ]]; then
                show_config
            elif [[ $# -eq 3 ]]; then
                set_config "$2" "$3"
            else
                echo "Usage: $0 config [key value]"
                exit 1
            fi
            ;;
        log)
            show_log "${2:-}" "${3:-50}"
            ;;
        analyze)
            analyze_pane "${2:-}"
            ;;
        monitor)
            shift || true
            "$MONITOR_CMD" "$@"
            ;;
        help|--help|-h)
            echo "tmux-claude-ctl - Control tmux-claude monitoring"
            echo
            echo "Usage: $0 [command] [args...]"
            echo
            echo "Commands:"
            echo "  status              Show current status and monitored panes"
            echo "  add|add-pane        Add current pane to monitoring"
            echo "  add-find-all        Find and add all Claude-like panes"
            echo "  clear [all]         Clear alerts for current pane or all panes"
            echo "  goto|next           Jump to next pane needing attention"
            echo "  mute|disable        Temporarily disable monitoring"
            echo "  unmute|enable       Re-enable monitoring"
            echo "  config [key val]    Show or set configuration"
            echo "  log [pane] [lines]  Show log for pane (default: current, 50 lines)"
            echo "  analyze [pane]      Analyze pane state (default: current)"
            echo "  monitor <cmd>       Control monitor daemon (start/stop/restart/status)"
            echo "  help                Show this help message"
            echo
            echo "Configuration keys:"
            echo "  timeout <seconds>   Inactivity timeout (default: 300)"
            echo "  notify <method>     Notification method (bell/flash/system/none)"
            echo "  style <style>       Display style (symbols/colors/both)"
            echo
            echo "Examples:"
            echo "  $0                  # Show status"
            echo "  $0 clear            # Clear current pane alert"
            echo "  $0 goto             # Jump to next alert"
            echo "  $0 config timeout 600  # Set 10 minute timeout"
            ;;
        *)
            echo "Unknown command: $1"
            echo "Use '$0 help' for usage information"
            exit 1
            ;;
    esac
}

main "$@"